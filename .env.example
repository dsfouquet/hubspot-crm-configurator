# Copy to .env.local and fill in. All optional — the app ships with working
# defaults baked in, so it deploys fine with no env vars set.
# Vite exposes only vars prefixed with VITE_ to the browser, at BUILD time.

# Booking link for qualified prospects (Free CRM Setup call)
VITE_BOOKING_URL=https://meetings-na2.hubspot.com/crescent/crm-demo-call

# DIY CRM Build Guide link for prospects who don't qualify for the Free Setup.
# Page not built yet — falls back to the Free CRM landing page until it is.
VITE_DIY_GUIDE_URL=https://www.crescentconnectla.com/free-crm

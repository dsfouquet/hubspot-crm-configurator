# Copy to .env.local and fill in. All optional — app runs without them.
# Vite exposes only vars prefixed with VITE_ to the browser.

# EmailJS (https://www.emailjs.com) — email delivery to prospect + Daniel
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_PROSPECT=
VITE_EMAILJS_TEMPLATE_DANIEL=

# Where lead-notification emails go
VITE_DANIEL_EMAIL=dsfouquet@gmail.com

# Claude API — Step 7 plain-English workflow generator
# NOTE: exposing this in the browser leaks the key. For a hosted public URL,
# proxy through a tiny serverless function instead. Fine for local/demo.
VITE_ANTHROPIC_API_KEY=

# Booking link shown on the final screen
VITE_CALENDLY_URL=https://calendly.com/
